# Single local configuration file: copy to ROOT .env and fill placeholders.
# Never commit .env. Platform environment variables override this file.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Local trusted migration CLI only; do not install owner credentials on a web host.
MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER_USER:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_OR_ANON_KEY
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
MINING_RUNS_PER_HOUR=6
MINING_TIMEOUT_SECONDS=300
MINING_MEMORY_MB=2048
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=900
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
SCHEDULER_RECONNECT_MAX_SECONDS=30
# DATA_DIR is optional; defaults to repository data/processed. Use persistent hosting storage.
# Do not add database/service-role/secret keys under any browser-public variable.
